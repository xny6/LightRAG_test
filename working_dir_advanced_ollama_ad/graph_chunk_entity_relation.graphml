<node id="USB-C Port">
  <data key="d0">USB-C Port</data>
  <data key="d1">category</data>
  <data key="d2">The USB-C Port is a type of port on the power adaptor used for charging devices, capable of delivering higher power output.</data>
  <data key="d3">chunk-0973d7d7882ae44716cb572ca4b5ffab</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1751270768</data>
