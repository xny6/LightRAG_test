  <data key="d0">USB-A Port</data>
  <data key="d1">category</data>
  <data key="d2">The USB-A Port is another type of port on the power adaptor, typically used for lower-power devices.</data>
  <data key="d3">chunk-0973d7d7882ae44716cb572ca4b5ffab</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1751270768</data>
