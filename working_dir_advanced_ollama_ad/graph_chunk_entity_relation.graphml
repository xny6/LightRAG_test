  <data key="d0">Multi-Port Charging</data>
  <data key="d1">category</data>
  <data key="d2">Multi-Port Charging refers to the use of multiple ports in a single adaptor to charge different devices simultaneously.</data>
  <data key="d3">chunk-0973d7d7882ae44716cb572ca4b5ffab</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1751270768</data>
</node>
<node id="Fast Charging Protocol">
  <data key="d0">Fast Charging Protocol</data>
  <data key="d1">category</data>
  <data key="d2">Fast Charging Protocol is a technology that allows for faster charging speeds, often requiring compatibility between the device and the adaptor.</data>
  <data key="d3">chunk-0973d7d7882ae44716cb572ca4b5ffab</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1751270768</data>
