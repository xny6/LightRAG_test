  <data key="d1">organization</data>
  <data key="d2">Sony Xperia supports eSIM functionality in Japan through features like dual SIM capability, NFC technology, 5G connectivity, and Android 13.</data>
  <data key="d3">chunk-bf69cc62c0a329c8e3c66816e77e3320</data>
  <data key="d4">unknown_source</data>
