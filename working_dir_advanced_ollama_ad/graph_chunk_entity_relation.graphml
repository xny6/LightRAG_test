  <data key="d0">aptX Adaptive Codec</data>
  <data key="d1">category</data>
  <data key="d2">The aptX Adaptive Codec is utilized by the Wireless Audio Device to provide high-quality audio streaming, enhancing the overall user experience with LDAC.</data>
  <data key="d3">chunk-4c58a1bef8840fb18692c87c343bce6b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1751270806</data>
