<node id="Connection Priority">
  <data key="d0">Connection Priority</data>
  <data key="d1">category</data>
  <data key="d2">When Dual Connection is enabled, the Nothing Ear 2 prioritizes reconnection based on the most recent usage of audio or calls on paired devices, ensuring seamless transitions between devices.</data>
  <data key="d3">chunk-e09ed589cc63a314f21cd40d0f894934</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1751270768</data>
</node>
<node id="Audio Output">
  <data key="d0">Audio Output</data>
  <data key="d1">category</data>
  <data key="d2">The Nothing Ear 2 manages audio output when Dual Connection is enabled by routing sound to the device with active audio playback or the most recently connected device, providing a smooth user experience.</data>
  <data key="d3">chunk-e09ed589cc63a314f21cd40d0f894934</data>
  <data key="d4">unknown_source</data>
