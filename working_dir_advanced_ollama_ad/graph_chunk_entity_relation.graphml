  <data key="d0">Heat Generation</data>
  <data key="d1">category</data>
  <data key="d2">Heat Generation occurs during the operation of the power adaptor due to energy conversion and resistance in electronic components.</data>
  <data key="d3">chunk-0973d7d7882ae44716cb572ca4b5ffab</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1751270768</data>
