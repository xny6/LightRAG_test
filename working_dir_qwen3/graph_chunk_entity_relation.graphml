<node id="Audio Routing">
  <data key="d0">Audio Routing</data>
  <data key="d1">category</data>
  <data key="d2">Audio Routing refers to how sound is directed to specific devices, such as phones or laptops, and is impacted by Bluetooth connectivity and device compatibility.</data>
  <data key="d3">chunk-39d4901014b867cda8bfaf59458315b9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1767407143</data>
</node>
<node id="Online Meeting">
  <data key="d0">Online Meeting</data>
  <data key="d1">event</data>
  <data key="d2">Online Meeting is an event where audio is streamed through a Bluetooth connection, and it may conflict with earbuds' default audio routing behavior.</data>
  <data key="d3">chunk-39d4901014b867cda8bfaf59458315b9</data>
  <data key="d4">unknown_source</data>
