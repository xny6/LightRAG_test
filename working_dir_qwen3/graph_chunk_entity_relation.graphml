  <data key="d11">1767407207</data>
</edge>
<edge source="Watch Pro" target="Nothing Phone">
  <data key="d6">8.0</data>
  <data key="d7">The Nothing Phone is the primary device used to sync time and weather data with the Watch Pro.</data>
