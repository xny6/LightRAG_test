  <data key="d1">organization</data>
  <data key="d2">Nothing Technologies is the company that develops and markets the Nothing Ear product line and related technologies, including the Nothing X app and customer support services.</data>
  <data key="d3">chunk-26891fa7fbcc5e292dab7ce65ee89518</data>
