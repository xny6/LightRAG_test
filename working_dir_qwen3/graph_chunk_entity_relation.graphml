  <data key="d5">1767407143</data>
</node>
<node id="Power Adaptor">
  <data key="d0">Power Adaptor</data>
  <data key="d1">equipment</data>
  <data key="d2">The power adaptor is a device that converts AC to DC, allowing charging of multiple devices. It has undergone safety certification and testing.&lt;SEP&gt;The power adaptor is a device that converts AC to DC, and may emit noise or sparks if used with incompatible sockets or components.</data>
  <data key="d3">chunk-de2595701f68717f24b26c16e73fef62&lt;SEP&gt;chunk-e598990cce04e756caad38b82dbe3eca</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1767407143</data>
</node>
