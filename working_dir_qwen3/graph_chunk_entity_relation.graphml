  <data key="d0">Adaptive EQ</data>
  <data key="d1">category</data>
  <data key="d2">Adaptive EQ is a feature in Nothing Ear that adjusts sound settings based on the user's ear canal leakage.</data>
  <data key="d3">chunk-92e27c35cbd2d81e7710bdeb957abdb9</data>
