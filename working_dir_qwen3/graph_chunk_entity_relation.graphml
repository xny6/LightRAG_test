</edge>
<edge source="Nothing phone" target="Battery percentage">
  <data key="d6">9.0</data>
  <data key="d7">Battery percentage is a feature of the Nothing phone that allows users to monitor their battery status.</data>
  <data key="d8">power management,user monitoring</data>
