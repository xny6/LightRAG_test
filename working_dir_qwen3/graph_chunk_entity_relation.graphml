  <data key="d0">AAC Bluetooth high-quality audio codec</data>
  <data key="d1">category</data>
  <data key="d2">AAC Bluetooth high-quality audio codec is a specific audio format supported by iOS devices, limiting their support for other high-quality audio codecs.</data>
  <data key="d3">chunk-6e908dc520371478d52528beaf43780b</data>
  <data key="d4">unknown_source</data>
