  <data key="d0">Google Play store</data>
  <data key="d1">geo</data>
  <data key="d2">"The Google Play store is an application marketplace for Android devices where users can download and update apps like the CMF Watch app."&gt;&lt;SEP&gt;Google Play store is a digital distribution platform for Android devices where apps can be downloaded.</data>
