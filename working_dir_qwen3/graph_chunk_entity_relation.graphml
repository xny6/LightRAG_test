  <data key="d10">unknown_source</data>
  <data key="d11">1767407197</data>
</edge>
<edge source="Watch Pro" target="Notification Settings">
  <data key="d6">8.0</data>
  <data key="d7">The Watch Pro's notification settings are managed through the CMF Watch app and determine how messages are displayed on the device.</data>
