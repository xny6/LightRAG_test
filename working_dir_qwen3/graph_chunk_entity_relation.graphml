<node id="Custom EQ Settings">
  <data key="d0">Custom EQ Settings</data>
  <data key="d1">category</data>
  <data key="d2">Custom EQ Settings are user-configurable audio equalizer options available on CMF Buds 2 through the Nothing X App.</data>
  <data key="d3">chunk-b6a5e79a49bc7db2a612f28136aee41c</data>
