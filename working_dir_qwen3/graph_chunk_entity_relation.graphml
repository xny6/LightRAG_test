  <data key="d0">Brightness</data>
  <data key="d1">category</data>
  <data key="d2">Brightness refers to the display setting that controls the intensity of the screen, and is adjustable within the Glyph Interface settings.</data>
  <data key="d3">chunk-5d866982ab2e7ced6661f8a940789dee</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1767407152</data>
