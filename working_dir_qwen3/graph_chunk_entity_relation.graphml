<node id="Nothing Find My Device">
  <data key="d0">Nothing Find My Device</data>
  <data key="d1">category</data>
  <data key="d2">Nothing Find My Device is a feature that enables users to locate their lost device using the phone's network connection and Google account.&lt;SEP&gt;Nothing Find My Device is a functionality on the Phone that allows users to locate their device and take actions to secure it if lost or misplaced.</data>
  <data key="d3">chunk-41ebb68d062de192afe8e06b1a67a1c4&lt;SEP&gt;chunk-9dbf1c133d4ea12599adde2c8babfb03</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1767407143</data>
</node>
<node id="Notification Status Bar">
  <data key="d0">Notification Status Bar</data>
  <data key="d1">category</data>
  <data key="d2">Notification Status Bar is a UI element that allows users to access notifications and other quick settings on their phone.&lt;SEP&gt;Notification Status Bar is a user interface component on the Nothing Phone that provides quick access to device controls, including the ability to enable NFC through the control centre.</data>
  <data key="d3">chunk-281d19d9c4f252fd5c844c3d467ca398&lt;SEP&gt;chunk-9dbf1c133d4ea12599adde2c8babfb03</data>
  <data key="d4">unknown_source</data>
