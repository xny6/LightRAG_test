<node id="App Settings">
  <data key="d0">App Settings</data>
  <data key="d1">category</data>
  <data key="d2">App Settings are the configurations on the iOS phone that control permissions and behaviors of the CMF Watch app, including background execution and notifications.&lt;SEP&gt;App Settings provide options for managing apps, including uninstallation, security, and configuration settings.</data>
  <data key="d3">chunk-5d866982ab2e7ced6661f8a940789dee&lt;SEP&gt;chunk-1937bef2f48d7dfa41b98235ae13df22</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1767407152</data>
