<edge source="Nothing phone" target="Heat dissipation">
  <data key="d6">9.0</data>
  <data key="d7">Heat dissipation refers to the management of heat generated by the Nothing phone during operation or charging, essential for device longevity.</data>
  <data key="d8">device performance,thermal management</data>
