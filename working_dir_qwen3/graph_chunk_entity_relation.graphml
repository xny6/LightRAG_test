  <data key="d1">category</data>
  <data key="d2">Music is a category of content that can be controlled via touch gestures on the Buds Pro earbuds, such as skipping forward or backward.</data>
  <data key="d3">chunk-3c721c853ee8f8f0dc302ae4d23208b8</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1767407143</data>
</node>
<node id="Volume">
  <data key="d0">Volume</data>
  <data key="d1">category</data>
  <data key="d2">Volume is a category of audio control that can be adjusted using custom gestures on the Buds Pro earbuds.</data>
  <data key="d3">chunk-3c721c853ee8f8f0dc302ae4d23208b8</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1767407143</data>
</node>
<node id="Gesture">
  <data key="d0">Gesture</data>
  <data key="d1">category</data>
  <data key="d2">Gesture is a category of user interaction that triggers various functions on the Buds Pro earbuds through touch controls.</data>
