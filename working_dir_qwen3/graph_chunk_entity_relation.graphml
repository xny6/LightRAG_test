<node id="Nothing Laboratories">
  <data key="d0">Nothing Laboratories</data>
  <data key="d1">organization</data>
  <data key="d2">Nothing Laboratories is the internal testing department of Nothing Technologies responsible for validating and determining battery life and performance metrics of the Nothing Ear product.&lt;SEP&gt;Nothing Laboratories is the internal testing facility of Nothing where battery life and other device performance metrics are evaluated under controlled conditions.</data>
  <data key="d3">chunk-26891fa7fbcc5e292dab7ce65ee89518&lt;SEP&gt;chunk-dbdc3aa884ec77acb84402d00879691d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1767407143</data>
