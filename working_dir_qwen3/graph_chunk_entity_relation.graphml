  <data key="d9">chunk-41ebb68d062de192afe8e06b1a67a1c4</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1767407207</data>
</edge>
<edge source="Phone (3a)" target="Dual 4G Mode">
  <data key="d6">9.0</data>
  <data key="d7">The Phone (3a) supports Dual 4G Mode, enabling both SIM cards to connect to the 4G network simultaneously.</data>
  <data key="d8">connectivity,sim support</data>
  <data key="d9">chunk-41ebb68d062de192afe8e06b1a67a1c4</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1767407207</data>
</edge>
<edge source="iOS phone" target="Notification Settings">
  <data key="d6">8.0</data>
  <data key="d7">The iOS phone has notification settings that determine whether messages are displayed on the status bar, which affects the Watch Pro's ability to receive notifications.</data>
  <data key="d8">app permissions,notification visibility</data>
  <data key="d9">chunk-1937bef2f48d7dfa41b98235ae13df22</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1767407207</data>
</edge>
<edge source="iOS phone" target="Background Power Consumption">
  <data key="d6">7.0</data>
  <data key="d7">The iOS phone's background power consumption settings may affect the CMF Watch app's ability to stay connected to the Watch Pro device.</data>
  <data key="d8">device connectivity,power management</data>
  <data key="d9">chunk-1937bef2f48d7dfa41b98235ae13df22</data>
  <data key="d10">unknown_source</data>
  <data key="d11">1767407207</data>
</edge>
<edge source="Nothing phone" target="Lock screen widgets">
  <data key="d6">9.0</data>
  <data key="d7">Lock screen widgets are features available on the Nothing phone, allowing customization of the lock screen interface.</data>
  <data key="d8">device customization,user interface</data>
