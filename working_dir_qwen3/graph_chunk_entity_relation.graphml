<node id="Active Score">
  <data key="d0">Active Score</data>
  <data key="d1">category</data>
  <data key="d2">Active Score is a health metric that quantifies physical activity using heart rate data, calculated over a rolling 7-day period and helps assess workout intensity and effectiveness.</data>
