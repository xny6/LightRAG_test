  <data key="d0">Bass Enhance</data>
  <data key="d1">category</data>
  <data key="d2">Bass Enhance is an audio enhancement feature in Nothing Ear that dynamically detects and enhances low-frequency signals in music to provide a more powerful bass experience.</data>
