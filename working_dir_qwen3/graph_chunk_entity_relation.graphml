<node id="Browser">
  <data key="d0">Browser</data>
  <data key="d1">category</data>
  <data key="d2">Browser is an application used for accessing the internet, and it includes features such as managing history and browsing data.&lt;SEP&gt;Browser is the application used to access the internet and manage browsing history, settings, and privacy options.&lt;SEP&gt;The browser is an application used to access the internet, and has features like clearing browsing data and managing network usage.</data>
  <data key="d3">chunk-8cd614c63bd30923f007ff94a3e7a5d9&lt;SEP&gt;chunk-3ce2dd4dcddbe486368b957aabc2e335&lt;SEP&gt;chunk-8238a048f616eaf02f92d0455ae0f39b</data>
