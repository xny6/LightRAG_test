<node id="Network connection">
  <data key="d0">Network connection</data>
  <data key="d1">category</data>
  <data key="d2">Network connection refers to the ability of the phone to connect to data networks or Wi-Fi, essential for features like tethering, location services, and internet access.</data>
  <data key="d3">chunk-e55e3fed26fabdb52106695b9582ce3b</data>
  <data key="d4">unknown_source</data>
