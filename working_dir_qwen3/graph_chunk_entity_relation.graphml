</node>
<node id="Bluetooth Settings">
  <data key="d0">Bluetooth Settings</data>
  <data key="d1">category</data>
  <data key="d2">Bluetooth Settings is a configuration option on a phone or device to manage connected devices, including Ear (open) earbuds, and to resolve connectivity issues.</data>
  <data key="d3">chunk-39d4901014b867cda8bfaf59458315b9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1767407143</data>
