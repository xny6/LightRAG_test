  <data key="d0">IPX2 rating</data>
  <data key="d1">category</data>
  <data key="d2">The IPX2 rating is a category of waterproofing standard for the charging case, indicating splashproof protection under controlled laboratory conditions.</data>
  <data key="d3">chunk-ecb83fc961a06d6a2e205ffa27cd9700</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1767407143</data>
</node>
<node id="IP54 rating">
  <data key="d0">IP54 rating</data>
  <data key="d1">category</data>
  <data key="d2">The IP54 rating is a category of dustproof and waterproof standard for the Buds Pro earbuds, indicating protection against dust and limited water exposure under controlled laboratory conditions.</data>
  <data key="d3">chunk-ecb83fc961a06d6a2e205ffa27cd9700</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1767407143</data>
