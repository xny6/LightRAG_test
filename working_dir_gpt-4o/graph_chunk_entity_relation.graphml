  <data key="d5">1767597569</data>
</node>
<node id="IPX2 Rating">
  <data key="d0">IPX2 Rating</data>
  <data key="d1">category</data>
  <data key="d2">The IPX2 rating signifies the Charging Case's resistance to water splashes when tested under controlled conditions.</data>
  <data key="d3">chunk-ecb83fc961a06d6a2e205ffa27cd9700</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1767597569</data>
