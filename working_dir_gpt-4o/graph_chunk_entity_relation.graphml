<node id="Smart ANC">
  <data key="d0">Smart ANC</data>
  <data key="d1">category</data>
  <data key="d2">Smart ANC is an advanced noise-canceling feature that adapts to external noise conditions and ear-insertion behavior.&lt;SEP&gt;Smart ANC is an algorithm in Nothing Ear earbuds that automatically adjusts the noise-cancelling effect based on ambient noise levels.</data>
  <data key="d3">chunk-26891fa7fbcc5e292dab7ce65ee89518&lt;SEP&gt;chunk-cbeb4732200e7559b14badeb7c65f47c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1767597614</data>
