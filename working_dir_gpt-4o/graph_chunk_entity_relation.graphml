  <data key="d0">Bluetooth Technology</data>
  <data key="d1">category</data>
  <data key="d2">Bluetooth Technology is a standard for wireless communication that enables the Ear (2) to connect with multiple devices like phones and PCs.</data>
  <data key="d3">chunk-716596cbb2a7e8b3702d6ceb7f52724e</data>
