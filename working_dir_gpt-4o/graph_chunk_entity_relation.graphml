  <data key="d1">product</data>
  <data key="d2">CMF Watch Pro is a smartwatch that connects to devices via Bluetooth, requiring troubleshooting steps for connectivity issues.</data>
  <data key="d3">chunk-39d4901014b867cda8bfaf59458315b9</data>
