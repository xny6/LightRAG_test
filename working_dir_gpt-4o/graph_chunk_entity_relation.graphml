<node id="ANC Modes">
  <data key="d0">ANC Modes</data>
  <data key="d1">feature</data>
  <data key="d2">ANC Modes available in Ear (1) are Maximum, Light, Transparency, and Off, offering varying levels of noise cancellation.</data>
  <data key="d3">chunk-56220d4c1145af0000fc9cb728dc6db7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1767597611</data>
