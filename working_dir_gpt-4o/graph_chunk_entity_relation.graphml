<node id="IP54">
  <data key="d0">IP54</data>
  <data key="d1">category</data>
  <data key="d2">IP54 is a rating indicating that Ear (a) earbuds are protected against dust ingress sufficient to prevent the product from operating normally and against water spray from all angles.</data>
