</node>
<node id="Customization">
  <data key="d0">Customization</data>
  <data key="d1">category</data>
  <data key="d2">Customization involves changing wallpaper and accent colors on the Nothing Phone for a personalized user interface.</data>
  <data key="d3">chunk-6b8eb92f55e1f3c041c691be7b6dbda7</data>
