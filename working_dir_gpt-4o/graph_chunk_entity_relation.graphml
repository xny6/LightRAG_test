  <data key="d1">event</data>
  <data key="d2">Battery Life Testing for Ear (2) assesses usage durations under varying conditions at Nothing laboratories.</data>
  <data key="d3">chunk-716596cbb2a7e8b3702d6ceb7f52724e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1767597614</data>
