<node id="Multi-task Management Interface">
  <data key="d0">Multi-task Management Interface</data>
  <data key="d1">category</data>
  <data key="d2">The Multi-task Management Interface on Android devices is used to manage running applications, such as locking apps for performance.</data>
  <data key="d3">chunk-06e37afdf610d89a09df8901349a725e</data>
