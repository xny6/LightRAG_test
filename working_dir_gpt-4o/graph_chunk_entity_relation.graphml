</node>
<node id="Google Photos">
  <data key="d0">Google Photos</data>
  <data key="d1">organization</data>
  <data key="d2">Google Photos is a cloud-based photo and video storage service, used for accessing screen recordings saved on the Nothing Phone.&lt;SEP&gt;Google Photos is a photo storage and sharing service by Google that can be used to access saved recordings from the Nothing Phone.</data>
  <data key="d3">chunk-124df9689f92596c4fbc5e0e680893f1&lt;SEP&gt;chunk-6b8eb92f55e1f3c041c691be7b6dbda7</data>
