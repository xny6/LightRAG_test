  <data key="d0">CMF Watch</data>
  <data key="d1">organization</data>
  <data key="d2">CMF Watch is an application mentioned as requiring certain start and lock procedures on Android devices for optimal performance.</data>
  <data key="d3">chunk-06e37afdf610d89a09df8901349a725e</data>
