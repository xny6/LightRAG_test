  <data key="d0">Plastic Housing</data>
  <data key="d1">category</data>
  <data key="d2">The plastic housing of Ear (a) is crafted from high-quality materials providing UV exposure and impact resistance.</data>
  <data key="d3">chunk-cbeb4732200e7559b14badeb7c65f47c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1767597614</data>
</node>
