<node id="Fertile Days">
  <data key="d0">Fertile Days</data>
  <data key="d1">category</data>
  <data key="d2">Fertile Days are the days in a menstrual cycle when an individual is most likely to conceive, and this information can be displayed in conjunction with the menstrual data.</data>
