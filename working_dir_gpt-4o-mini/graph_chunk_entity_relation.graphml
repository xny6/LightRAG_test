<node id="Adaptive Mode">
  <data key="d0">Adaptive Mode</data>
  <data key="d1">feature</data>
  <data key="d2">Adaptive Mode is a function that dynamically monitors environmental noise and adjusts noise cancellation for optimal audio experience.</data>
  <data key="d3">chunk-3a8564fc99ee9391246494d993bc4be4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1767612157</data>
