<node id="Training Load">
  <data key="d0">Training Load</data>
  <data key="d1">category</data>
  <data key="d2">Training Load is a measure of the physical stress exerted on the body during workouts, allowing users to track their fatigue levels and optimize training schedules.</data>
  <data key="d3">chunk-2666978485c7758b69e3c834ba80fefe</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1767612291</data>
