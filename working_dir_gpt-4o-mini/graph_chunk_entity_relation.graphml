  <data key="d0">Menstrual Period</data>
  <data key="d1">category</data>
  <data key="d2">Menstrual Period refers to the monthly cycle experienced by individuals with a uterus, which can be tracked using the app to synchronize personal health data.</data>
  <data key="d3">chunk-2666978485c7758b69e3c834ba80fefe</data>
