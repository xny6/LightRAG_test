<node id="Environmental Noise Cancellation">
  <data key="d0">Environmental Noise Cancellation</data>
  <data key="d1">category</data>
  <data key="d2">Environmental Noise Cancellation (ENC) is designed to filter out background noise during phone calls, ensuring clear communication.</data>
