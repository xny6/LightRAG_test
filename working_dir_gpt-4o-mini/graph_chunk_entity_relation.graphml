</node>
<node id="AAC">
  <data key="d0">AAC</data>
  <data key="d1">technology</data>
  <data key="d2">AAC is an audio codec supported by iOS devices for high-quality audio playback, but it offers a lower quality compared to LDAC.&lt;SEP&gt;AAC is an audio codec supported by the CMF Buds Pro 2, providing enhanced audio quality for streaming.</data>
  <data key="d3">chunk-242b40fbdd789fce17cd5d53222cb91d&lt;SEP&gt;chunk-8c10ba86f3c652add8c1d23db1a9625b</data>
