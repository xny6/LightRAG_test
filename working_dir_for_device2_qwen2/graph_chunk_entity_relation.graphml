  <data key="d0">车位引导屏</data>
  <data key="d1">device</data>
  <data key="d2">车位引导屏向驾驶员显示当前停车场的可用停车位信息，提高停车效率。</data>
  <data key="d3">chunk-0bcbcaac15fff56dfd6ef3e2d80be6e4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1757554098</data>
</node>
<node id="UPS">
  <data key="d0">UPS</data>
  <data key="d1">organization</data>
  <data key="d2">UPS"包含各种属性如电压、电流和频率等，表示一个设备或系统。&lt;SEP&gt;UPS(不间断电源系统)是一种备用电源设备，在停电时为关键负载提供持续电力供应。&lt;SEP&gt;不间断电源系统(UPS)在停电时为关键设备提供备用能源</data>
  <data key="d3">chunk-0bcbcaac15fff56dfd6ef3e2d80be6e4&lt;SEP&gt;chunk-0baf951a358cd311c49a75a1a13718c3&lt;SEP&gt;chunk-4e7dfd62344442735858b0c4c7806d7f</data>
  <data key="d4">unknown_source</data>
