  <data key="d0">一氧化碳传感器</data>
  <data key="d1">device</data>
  <data key="d2">一氧化碳传感器监测环境中的一氧化碳浓度，保护人员健康与安全。</data>
  <data key="d3">chunk-0bcbcaac15fff56dfd6ef3e2d80be6e4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1757554099</data>
</node>
<node id="二氧化碳传感器">
  <data key="d0">二氧化碳传感器</data>
  <data key="d1">device</data>
  <data key="d2">专门用于检测空气中二氧化碳浓度的设备。&lt;SEP&gt;二氧化碳传感器监控空气中的CO2含量，确保室内空气质量符合健康标准。</data>
  <data key="d3">chunk-0bcbcaac15fff56dfd6ef3e2d80be6e4&lt;SEP&gt;chunk-399c47c974446de309c4f5edac0b59d4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1757554099</data>
</node>
<node id="压力传感器">
  <data key="d0">压力传感器</data>
  <data key="d1">device</data>
  <data key="d2">压力传感器用于测量不同环境或系统内的压力变化，适用于多种工业应用。&lt;SEP&gt;用于监测系统内的压力水平并将其数据转换为电子信号反馈给控制系统。在冷源管理中，压力传感器用于确保系统的压力保持在安全、有效的范围内。</data>
  <data key="d3">chunk-0bcbcaac15fff56dfd6ef3e2d80be6e4&lt;SEP&gt;chunk-6bc4d003d6ba779c2c7df3b4dd2d24d3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1757554099</data>
</node>
<node id="烟雾传感器">
  <data key="d0">烟雾传感器</data>
  <data key="d1">device</data>
  <data key="d2">烟雾传感器检测火灾引起的烟雾，及时触发报警并预防安全事故。</data>
  <data key="d3">chunk-0bcbcaac15fff56dfd6ef3e2d80be6e4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1757554099</data>
</node>
<node id="空气质量传感器">
  <data key="d0">空气质量传感器</data>
  <data key="d1">device</data>
  <data key="d2">空气质量传感器监测室内或室外环境的PM2.5、O3等污染物浓度，维护良好的生活和工作条件。</data>
  <data key="d3">chunk-0bcbcaac15fff56dfd6ef3e2d80be6e4</data>
